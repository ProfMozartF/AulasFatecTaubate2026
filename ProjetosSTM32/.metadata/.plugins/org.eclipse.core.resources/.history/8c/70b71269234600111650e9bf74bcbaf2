  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_ADC1_Init();
  MX_TIM1_Init();
  MX_USART1_UART_Init();
  MX_TIM2_Init();
  /* USER CODE BEGIN 2 */
  HAL_ADC_Stop(&hadc1); //Desabilita o periférico
  HAL_ADCEx_Calibration_Start(&hadc1);
  HAL_ADC_Start_DMA(&hadc1, (uint32_t *)ADCBuffer, 4);

  __HAL_TIM_ENABLE(&htim1);
  HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
  HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_4);

  PWM_Forward = 0;
  PWM_Reverse = 0;

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
	  voltPedal1 = retornaVolt(AN2);
	  voltPedal2 = retornaVolt(AN3);
	  voltPotBorboleta1 = retornaVolt(AN0);
	  voltPotBorboleta2 = retornaVolt(AN1);

	  if(checkPedal(voltPedal1, voltPedal2)== 0){
		  sprintf(mensagem, "FALHA FUNCIONAL NO PEDAL\r\n");
		  HAL_UART_Transmit(&huart1, (uint8_t*)mensagem, strlen(mensagem), 50);
	 }

	  if(CheckVoltSensor(voltPedal1,PosicaoPedal1)==1){
		  PorcPedal = (voltPedal1-0.56)/0.0271;
	  }
	  if(CheckVoltSensor(voltPedal2,PosicaoPedal2)){
		  //em espera
	  }
	  if(CheckVoltSensor(voltPotBorboleta1,PosicaoBorboleta1)==1){
		  PorcBorboleta = (voltPotBorboleta1-0.42)/0.02806;
	  }
	  if(CheckVoltSensor(voltPotBorboleta2,PosicaoBorboleta2)){
		  //em espera
	  }

	 if (PorcPedal < 0.0f) {
		 PorcPedal = 0.0f;
	 } else if (PorcPedal > 100.0f) {
		 PorcPedal = 100.0f;
	 }


	 float pwmPercent = ETC_Control_Step(RefPosBorboleta, PorcBorboleta);
	 PWM_Forward = (uint16_t)(pwmPercent * 4.9f);  // 100% → CCR 490
	 if (PWM_Forward > 490) PWM_Forward = 490;
	 PWM_Forward = (uint16_t)(pwmPercent * 5.0f);
	 if(PWM_Forward > 490){PWM_Forward = 490;}
	 else if(PWM_Forward < 5){PWM_Forward = 5;}

	 TIM1->CCR1 = PWM_Forward; //Atualiza o valor do comparador que gera o Duty+
	 TIM1->CCR4 = PWM_Reverse;
HAL_Delay(10);
//HAL_GPIO_TogglePin(Led_GPIO_Port, Led_Pin);

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
